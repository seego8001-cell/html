:root {
  --blue-1: #0d5bbf;
  --blue-2: #2196f3;
  --btn: #1565c0;
  --btn-hover: #0d47a1;
  --bg: #e8f0fb;
  --text: #1f2a44;
  --border: #c9d3e3;
  --error: #c62828;
  --ok: #2e7d32;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: "Noto Sans Khmer", "Khmer OS", system-ui, sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ក្បាលទំព័រ */
.site-header {
  background: linear-gradient(90deg, var(--blue-1), var(--blue-2));
  color: #fff;
  text-align: center;
  padding: 22px 16px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, .15);
}
.site-header h1 { font-size: 2rem; font-weight: 700; }

/* ខ្លឹមសារ */
.container {
  width: 100%;
  max-width: 390px;
  margin: 20px auto;
  padding: 0 12px;
  flex: 1;
}

.card {
  background: #fff;
  border-radius: 14px;
  padding: 18px 16px;
  margin-bottom: 22px;
  box-shadow: 0 4px 14px rgba(20, 60, 120, .15);
}
.card h2 {
  text-align: center;
  color: var(--blue-1);
  font-size: 1.6rem;
  margin-bottom: 14px;
}

/* Form */
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px 14px;
}
.field label {
  display: block;
  font-weight: 700;
  font-size: .95rem;
  margin-bottom: 4px;
}

input, select {
  width: 100%;
  font-family: inherit;
  font-size: .95rem;
  padding: 8px 10px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: #fff;
  color: var(--text);
}
input:focus, select:focus, .btn:focus-visible {
  outline: 2px solid var(--blue-2);
  outline-offset: 1px;
}
select:disabled { background: #f2f4f8; color: #8a94a6; }

.tel-group {
  display: flex;
  margin-top: 4px;
}
.tel-prefix {
  display: flex;
  align-items: center;
  padding: 0 12px;
  background: #eceff4;
  border: 1px solid var(--border);
  border-right: 0;
  border-radius: 6px 0 0 6px;
  color: #555;
}
.tel-group input { border-radius: 0 6px 6px 0; }

.card > input { margin-bottom: 10px; }

.btn {
  display: block;
  width: 100%;
  margin-top: 12px;
  padding: 9px;
  font-family: inherit;
  font-size: 1rem;
  font-weight: 600;
  color: #fff;
  background: var(--btn);
  border: 0;
  border-radius: 6px;
  cursor: pointer;
  transition: background .15s;
}
.btn:hover { background: var(--btn-hover); }

.msg { min-height: 1.2em; margin-top: 8px; font-size: .9rem; }
.msg.error { color: var(--error); }
.msg.ok { color: var(--ok); }

/* លទ្ធផលស្វែងរក */
.result {
  margin-top: 12px;
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 10px 12px;
  min-height: 40px;
  font-size: .95rem;
  line-height: 1.7;
}
.result .row { display: flex; gap: 6px; }
.result .key { font-weight: 700; min-width: 110px; }
.result .not-found { color: var(--error); }

/* បាតទំព័រ */
.site-footer {
  text-align: center;
  padding: 14px;
  font-size: .95rem;
  border-top: 1px solid #d5dfef;
}

/* ទូរស័ព្ទតូចៗ */
@media (max-width: 380px) {
  .grid { grid-template-columns: 1fr; }
  .site-header h1 { font-size: 1.5rem; }
}
